# Copier en .env à la racine du projet (docker compose le lit automatiquement).
DJANGO_SECRET_KEY=changer-moi-par-une-longue-valeur-aleatoire
# Hôtes autorisés (IP du PC serveur, séparées par des virgules) ; * pour la démo en réseau local.
DJANGO_ALLOWED_HOSTS=*
DB_NAME=labtrack
DB_USER=labtrack
DB_PASSWORD=changer-moi
LABTRACK_PORT=8000
